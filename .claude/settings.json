{
  "permissions": {
    "deny": [
      "Bash(pnpm eval:agents:*)",
      "Bash(pnpm run eval:agents:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-unsafe.sh"
          }
        ]
      }
    ]
  }
}
