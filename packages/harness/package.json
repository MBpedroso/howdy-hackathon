{
  "name": "@rematch/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The four deterministic gates that decide whether a generated strategy ships, plus the CLI.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "rematch-harness": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "cli": "node --experimental-strip-types src/cli.ts",
    "test:balance": "vitest run --passWithNoTests --reporter=verbose balance",
    "test": "vitest run"
  },
  "dependencies": {
    "@rematch/contract": "workspace:*",
    "@rematch/engine": "workspace:*",
    "@rematch/sandbox": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
