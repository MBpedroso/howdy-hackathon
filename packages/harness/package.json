{
  "name": "@rematch/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The four gates that decide whether a generated strategy ships - three reproducible, one a wall-clock perf measurement - plus the CLI.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "rematch-harness": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "cli": "node --experimental-strip-types src/cli.ts",
    "test:balance": "vitest run --passWithNoTests --reporter=verbose balance",
    "recheck:active": "node --experimental-strip-types scripts/recheck-active.ts",
    "test": "vitest run",
    "recheck:adapted": "node --experimental-strip-types scripts/recheck-adapted.ts",
    "regrade:live": "node --experimental-strip-types scripts/regrade-live.ts",
    "evidence:parallel": "node --experimental-strip-types scripts/parallel-evidence.ts"
  },
  "dependencies": {
    "@rematch/contract": "workspace:*",
    "@rematch/engine": "workspace:*",
    "@rematch/sandbox": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
