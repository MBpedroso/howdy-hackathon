{
  "name": "@rematch/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QuickJS sandbox for generated boss strategies: no host bindings, seeded PRNG, 2 ms deadline, 64 MB heap.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "node --experimental-strip-types test/bench.ts"
  },
  "dependencies": {
    "@rematch/contract": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "quickjs-emscripten": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
