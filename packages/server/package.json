{
  "name": "@rematch/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP + SSE over the rewrite loop, the fallback pool, and the rate limit (spec §5).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types --env-file-if-exists=../../.env src/main.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@rematch/agents": "workspace:*",
    "@rematch/contract": "workspace:*",
    "@rematch/engine": "workspace:*",
    "@rematch/harness": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
