{
  "name": "rematch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "pnpm -r run test",
    "test:contract": "pnpm --filter @rematch/contract run test",
    "test:sandbox": "pnpm --filter @rematch/sandbox run test",
    "test:engine": "pnpm --filter @rematch/engine run test",
    "test:harness": "pnpm --filter @rematch/harness run test",
    "test:balance": "pnpm --filter @rematch/harness run test:balance",
    "harness": "pnpm --filter @rematch/harness cli --",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
